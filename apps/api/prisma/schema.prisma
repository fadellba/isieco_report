  photoInterventionVarianteSoumisePar                          PhotoIntervention[]            @relation("photo_intervention_variante_soumise_par")
  photoSignalement                                              PhotoSignalement[]
  photoSignalementVarianteSoumisePar                           PhotoSignalement[]              @relation("photo_signalement_variante_soumise_par")
  preferencesVisibiliteCitoyen                                  PreferencesVisibiliteCitoyen?
  provenanceContenuDossier                                      ProvenanceContenuDossier[]
  publicationFluxPublicationFluxApprouveParToutilisateur        PublicationFlux[]               @relation("publication_flux_approuve_parToutilisateur")
  publicationFluxPublicationFluxCreeParToutilisateur            PublicationFlux[]               @relation("publication_flux_cree_parToutilisateur")
  qualificationSignalement                                      QualificationSignalement[]
  rattachementSignalement                                       RattachementSignalement[]
  session                                                       Session[]
  signalementSignalementDecisionParToutilisateur                Signalement[]                   @relation("signalement_decision_parToutilisateur")
  signalementSignalementIdUtilisateurToutilisateur              Signalement[]                   @relation("signalement_id_utilisateurToutilisateur")
  utilisateurRoleUtilisateurRoleAttribueParToutilisateur        UtilisateurRole[]               @relation("utilisateur_role_attribue_parToutilisateur")
  utilisateurRoleUtilisateurRoleIdUtilisateurToutilisateur      UtilisateurRole[]               @relation("utilisateur_role_id_utilisateurToutilisateur")
  verificationResolution                                        VerificationResolution[]

  @@map("utilisateur")
}

model UtilisateurRole {
  idUtilisateur                                        String       @map("id_utilisateur") @db.Uuid
  idRole                                               String       @map("id_role") @db.Uuid
  dateDebut                                            DateTime     @default(now()) @map("date_debut") @db.Timestamptz(6)
  dateFin                                              DateTime?    @map("date_fin") @db.Timestamptz(6)
  attribuePar                                          String?      @map("attribue_par") @db.Uuid
  motif                                                String?      @db.Text
  utilisateurUtilisateurRoleAttribueParToutilisateur   Utilisateur? @relation("utilisateur_role_attribue_parToutilisateur", fields: [attribuePar], references: [idUtilisateur], onUpdate: NoAction)
  role                                                 Role         @relation(fields: [idRole], references: [idRole], onUpdate: NoAction)
  utilisateurUtilisateurRoleIdUtilisateurToutilisateur Utilisateur  @relation("utilisateur_role_id_utilisateurToutilisateur", fields: [idUtilisateur], references: [idUtilisateur], onDelete: Cascade, onUpdate: NoAction)

  @@id([idUtilisateur, idRole, dateDebut], map: "pk_utilisateur_role")
  @@map("utilisateur_role")
}

model VerificationResolution {
  idVerification       String            @id @default(dbgenerated("gen_random_uuid()")) @map("id_verification") @db.Uuid
  idAffectation        String            @map("id_affectation") @db.Uuid
  idVerificateur       String            @map("id_verificateur") @db.Uuid
  dateVerification     DateTime          @default(now()) @map("date_verification") @db.Timestamptz(6)
  resultatVerification String            @map("resultat_verification") @db.VarChar(30)
  etatVerification     String            @default("COURANTE") @map("etat_verification") @db.VarChar(20)
  motif                String?           @db.Text
  referencePreuve      String?           @map("reference_preuve") @db.VarChar(255)
  evenementMetier      EvenementMetier[]
  utilisateur          Utilisateur       @relation(fields: [idVerificateur], references: [idUtilisateur], onUpdate: NoAction)
  affectation          Affectation       @relation(fields: [idAffectation], references: [idAffectation], onUpdate: NoAction)

  @@map("verification_resolution")
}
