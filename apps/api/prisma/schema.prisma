generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Affectation {
  idAffectation                                 String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id_affectation") @db.Uuid
  idDossier                                     String                   @map("id_dossier") @db.Uuid
  idTypeDechet                                  String                   @map("id_type_dechet") @db.Uuid
  idEquipe                                      String                   @map("id_equipe") @db.Uuid
  idCompetenceEquipe                            String                   @map("id_competence_equipe") @db.Uuid
  dateHeureAffectation                          DateTime                 @default(now()) @map("date_heure_affectation") @db.Timestamptz(6)
  idDecideur                                    String                   @map("id_decideur") @db.Uuid
  etatAffectation                               String                   @default("ACTIVE") @map("etat_affectation") @db.VarChar(20)
  motif                                         String?                  @db.Text
  observation                                   String?                  @db.Text
  dateFinAffectation                            DateTime?                @map("date_fin_affectation") @db.Timestamptz(6)
  decisionEquipe                                String                   @default("EN_ATTENTE") @map("decision_equipe") @db.VarChar(20)
  reponduPar                                    String?                  @map("repondu_par") @db.Uuid
  dateReponseEquipe                             DateTime?                @map("date_reponse_equipe") @db.Timestamptz(6)
  motifRefusEquipe                              String?                  @map("motif_refus_equipe") @db.Text
  referenceOperationUnique                      String?                  @unique @map("reference_operation_unique") @db.VarChar(100)
  competenceEquipe                              CompetenceEquipe         @relation(fields: [idCompetenceEquipe, idEquipe, idTypeDechet], references: [idCompetenceEquipe, idEquipe, idTypeDechet], onUpdate: NoAction, map: "fk_affectation_competence_equipe")
  contenuDossier                                ContenuDossier           @relation(fields: [idDossier, idTypeDechet], references: [idDossier, idTypeDechet], onUpdate: NoAction, map: "fk_affectation_contenu_dossier")
  utilisateurAffectationReponduParToutilisateur Utilisateur?             @relation("affectation_repondu_parToutilisateur", fields: [reponduPar], references: [idUtilisateur], onDelete: Restrict, onUpdate: NoAction)
  utilisateurAffectationIdDecideurToutilisateur Utilisateur              @relation("affectation_id_decideurToutilisateur", fields: [idDecideur], references: [idUtilisateur], onUpdate: NoAction)
  equipe                                        Equipe                   @relation(fields: [idEquipe], references: [idEquipe], onUpdate: NoAction)
  evenementMetier                               EvenementMetier[]
  intervention                                  Intervention[]
  verificationResolution                        VerificationResolution[]

  @@map("affectation")
}

model AppartenanceEquipe {
  idUtilisateur            String                     @map("id_utilisateur") @db.Uuid
  idEquipe                 String                     @map("id_equipe") @db.Uuid
  dateDebut                DateTime                   @default(now()) @map("date_debut") @db.Timestamptz(6)
  dateFin                  DateTime?                  @map("date_fin") @db.Timestamptz(6)
  fonction                 String                     @default("AGENT_TERRAIN") @db.VarChar(100)
  equipe                   Equipe                     @relation(fields: [idEquipe], references: [idEquipe], onDelete: Cascade, onUpdate: NoAction)
  utilisateur              Utilisateur                @relation(fields: [idUtilisateur], references: [idUtilisateur], onDelete: Cascade, onUpdate: NoAction)
  delegationDecisionEquipe DelegationDecisionEquipe[]

  @@id([idUtilisateur, idEquipe, dateDebut], map: "pk_appartenance_equipe")
  @@map("appartenance_equipe")
}

model Badge {
  idBadge          String             @id @default(dbgenerated("gen_random_uuid()")) @map("id_badge") @db.Uuid
  codeBadge        String             @unique @map("code_badge") @db.VarChar(50)
  libelle          String             @db.VarChar(100)
  description      String?            @db.Text
  actif            Boolean            @default(true) @db.Boolean
  badgeUtilisateur BadgeUtilisateur[]

  @@map("badge")
}

model BadgeUtilisateur {
  idUtilisateur                                         String       @map("id_utilisateur") @db.Uuid
  idBadge                                               String       @map("id_badge") @db.Uuid
  dateAttribution                                       DateTime     @default(now()) @map("date_attribution") @db.Timestamptz(6)
  attribuePar                                           String?      @map("attribue_par") @db.Uuid
  motif                                                 String?      @db.Text
  utilisateurBadgeUtilisateurAttribueParToutilisateur   Utilisateur? @relation("badge_utilisateur_attribue_parToutilisateur", fields: [attribuePar], references: [idUtilisateur], onUpdate: NoAction)
  badge                                                 Badge        @relation(fields: [idBadge], references: [idBadge], onUpdate: NoAction)
  utilisateurBadgeUtilisateurIdUtilisateurToutilisateur Utilisateur  @relation("badge_utilisateur_id_utilisateurToutilisateur", fields: [idUtilisateur], references: [idUtilisateur], onDelete: Cascade, onUpdate: NoAction)

  @@id([idUtilisateur, idBadge])
  @@map("badge_utilisateur")
}

model Commune {
  idCommune                     String                          @id @default(dbgenerated("gen_random_uuid()")) @map("id_commune") @db.Uuid
  idDepartement                 String                          @map("id_departement") @db.Uuid
  codeCommune                   String?                         @map("code_commune") @db.VarChar(30)
  nomCommune                    String                          @map("nom_commune") @db.VarChar(120)
  actif                         Boolean                         @default(true) @db.Boolean
  departement                   Departement                     @relation(fields: [idDepartement], references: [idDepartement], onUpdate: NoAction)
  dossierTraitement             DossierTraitement[]
  historiqueLocalisationDossier HistoriqueLocalisationDossier[]
  signalement                   Signalement[]

  @@unique([idCommune, idDepartement], map: "uq_commune_departement_id")
  @@unique([idDepartement, codeCommune], map: "uq_commune_departement_code")
  @@unique([idDepartement, nomCommune], map: "uq_commune_departement_nom")
  @@map("commune")
}

model CompetenceEquipe {
  idCompetenceEquipe String            @id @default(dbgenerated("gen_random_uuid()")) @map("id_competence_equipe") @db.Uuid
  idEquipe           String            @map("id_equipe") @db.Uuid
  idTypeDechet       String            @map("id_type_dechet") @db.Uuid
  dateDebut          DateTime          @default(now()) @map("date_debut") @db.Timestamptz(6)
  dateFin            DateTime?         @map("date_fin") @db.Timestamptz(6)
  commentaire        String?           @db.Text
  valideePar         String?           @map("validee_par") @db.Uuid
  affectation        Affectation[]
  utilisateur        Utilisateur?      @relation(fields: [valideePar], references: [idUtilisateur], onUpdate: NoAction)
  typeDechet         TypeDechet        @relation(fields: [idTypeDechet], references: [idTypeDechet], onUpdate: NoAction)
  equipe             Equipe            @relation(fields: [idEquipe], references: [idEquipe], onDelete: Cascade, onUpdate: NoAction)
  evenementMetier    EvenementMetier[]

  @@unique([idCompetenceEquipe, idEquipe, idTypeDechet], map: "uq_competence_equipe_composition")
  @@unique([idEquipe, idTypeDechet, dateDebut], map: "uq_competence_equipe_triplet")
  @@map("competence_equipe")
}

model ContenuDossier {
  idDossier                                         String                     @map("id_dossier") @db.Uuid
  idTypeDechet                                      String                     @map("id_type_dechet") @db.Uuid
  quantiteEstimee                                   Decimal?                   @map("quantite_estimee") @db.Decimal(12, 3)
  uniteQuantite                                     String?                    @map("unite_quantite") @db.VarChar(30)
  quantiteEstimeeLegacy                             String?                    @map("quantite_estimee_legacy") @db.VarChar(50)
  volumeEstime                                      String?                    @map("volume_estime") @db.VarChar(50)
  niveauRisqueQualifie                              String?                    @default("MOYEN") @map("niveau_risqu_qualifie") @db.VarChar(20)
  remarque                                          String?                    @db.Text
  qualifiePar                                       String?                    @map("qualifie_par") @db.Uuid
  dateQualification                                 DateTime?                  @map("date_qualification") @db.Timestamptz(6)
  etatContenuDossier                                String                     @default("INCLUSE") @map("etat_contenu_dossier") @db.VarChar(20)
  etatPriseEnCharge                                 String                     @default("A_AFFECTER") @map("etat_prise_en_charge") @db.VarChar(25)
  dateAttenteEquipe                                 DateTime?                  @map("date_attente_equipe") @db.Timestamptz(6)
  motifAttenteEquipe                                String?                    @map("motif_attente_equipe") @db.Text
  dateRetrait                                       DateTime?                  @map("date_retrait") @db.Timestamptz(6)
  retirePar                                         String?                    @map("retire_par") @db.Uuid
  motifRetrait                                      String?                    @map("motif_retrait") @db.Text
  origineAjout                                      String                     @default("AJOUT_MANUEL") @map("origine_ajout") @db.VarChar(30)
  motifAjout                                        String?                    @map("motif_ajout") @db.Text
  affectation                                       Affectation[]
  utilisateurContenuDossierRetireParToutilisateur   Utilisateur?               @relation("contenu_dossier_retire_parToutilisateur", fields: [retirePar], references: [idUtilisateur], onUpdate: NoAction)
  utilisateurContenuDossierQualifieParToutilisateur Utilisateur?               @relation("contenu_dossier_qualifie_parToutilisateur", fields: [qualifiePar], references: [idUtilisateur], onUpdate: NoAction)
  typeDechet                                        TypeDechet                 @relation(fields: [idTypeDechet], references: [idTypeDechet], onUpdate: NoAction)
  dossierTraitement                                 DossierTraitement          @relation(fields: [idDossier], references: [idDossier], onDelete: Cascade, onUpdate: NoAction)
  evenementMetier                                   EvenementMetier[]
  provenanceContenuDossier                          ProvenanceContenuDossier[]

  @@id([idDossier, idTypeDechet], map: "pk_contenu_dossier")
  @@map("contenu_dossier")
}

model DelegationDecisionEquipe {
  idDelegation          String             @id @default(dbgenerated("gen_random_uuid()")) @map("id_delegation") @db.Uuid
  idEquipe              String             @map("id_equipe") @db.Uuid
  idUtilisateurDelegue  String             @map("id_utilisateur_delegue") @db.Uuid
  dateDebutAppartenance DateTime           @map("date_debut_appartenance") @db.Timestamptz(6)
  typeDecision          String             @map("type_decision") @db.VarChar(40)
  deleguePar            String             @map("delegue_par") @db.Uuid
  dateDebut             DateTime           @default(now()) @map("date_debut") @db.Timestamptz(6)
  dateFin               DateTime?          @map("date_fin") @db.Timestamptz(6)
  motif                 String?            @db.Text
  appartenanceEquipe    AppartenanceEquipe @relation(fields: [idUtilisateurDelegue, idEquipe, dateDebutAppartenance], references: [idUtilisateur, idEquipe, dateDebut], onUpdate: NoAction, map: "fk_delegation_membre")
  utilisateur           Utilisateur        @relation(fields: [deleguePar], references: [idUtilisateur], onUpdate: NoAction)
  equipe                Equipe             @relation(fields: [idEquipe], references: [idEquipe], onUpdate: NoAction)

  @@unique([idEquipe, idUtilisateurDelegue, typeDecision, dateDebut], map: "uq_delegation_debut")
  @@map("delegation_decision_equipe")
}

model Departement {
  idDepartement   String    @id @default(dbgenerated("gen_random_uuid()")) @map("id_departement") @db.Uuid
  idRegion        String    @map("id_region") @db.Uuid
  codeDepartement String?   @map("code_departement") @db.VarChar(30)
  nomDepartement  String    @map("nom_departement") @db.VarChar(120)
  actif           Boolean   @default(true) @db.Boolean
  commune         Commune[]
  region          Region    @relation(fields: [idRegion], references: [idRegion], onUpdate: NoAction)

  @@unique([idDepartement, idRegion], map: "uq_departement_region_id")
  @@unique([idRegion, codeDepartement], map: "uq_departement_region_code")
  @@unique([idRegion, nomDepartement], map: "uq_departement_region_nom")
  @@map("departement")
}

model DisponibiliteEquipe {
  idEquipe          String      @id @map("id_equipe") @db.Uuid
  etatDisponibilite String      @map("etat_disponibilite") @db.VarChar(20)
  miseAJourPar      String      @map("mise_a_jour_par") @db.Uuid
  dateMiseAJour     DateTime    @default(now()) @map("date_mise_a_jour") @db.Timestamptz(6)
  valideJusqua      DateTime    @map("valide_jusqua") @db.Timestamptz(6)
  commentaire       String?     @db.Text
  utilisateur       Utilisateur @relation(fields: [miseAJourPar], references: [idUtilisateur], onUpdate: NoAction)
  equipe            Equipe?     @relation(fields: [idEquipe], references: [idEquipe], onDelete: Cascade, onUpdate: NoAction)

  @@map("disponibilite_equipe")
}

model DossierTraitement {
  idDossier                     String                          @id @default(dbgenerated("gen_random_uuid()")) @map("id_dossier") @db.Uuid
  referenceDossier              String                          @unique @map("reference_dossier") @db.VarChar(50)
  descriptionSynthese           String                          @map("description_synthese") @db.Text
  dateCreationDossier           DateTime                        @default(now()) @map("date_creation_dossier") @db.Timestamptz(6)
  statutDossier                 String                          @default("A_QUALIFIER") @map("statut_dossier") @db.VarChar(35)
  priorite                      String                          @default("MOYENNE") @db.VarChar(20)
  dateQualification             DateTime?                       @map("date_qualification") @db.Timestamptz(6)
  idCommune                     String?                         @map("id_commune") @db.Uuid
  latitude                      Decimal?                        @db.Decimal(10, 7)
  longitude                     Decimal?                        @db.Decimal(10, 7)
  precisionLocalisation         Decimal?                        @map("precision_localisation") @db.Decimal(8, 2)
  descriptionLocalisation       String?                         @map("description_localisation") @db.Text
  dateCloture                   DateTime?                       @map("date_cloture") @db.Timestamptz(6)
  creePar                       String                          @map("cree_par") @db.Uuid
  contenuDossier                ContenuDossier[]
  utilisateur                   Utilisateur                     @relation(fields: [creePar], references: [idUtilisateur], onUpdate: NoAction)
  commune                       Commune?                        @relation(fields: [idCommune], references: [idCommune], onDelete: Restrict, onUpdate: NoAction)
  evenementMetier               EvenementMetier[]
  historiqueLocalisationDossier HistoriqueLocalisationDossier[]
  historiquePrioriteDossier     HistoriquePrioriteDossier[]
  publicationFlux               PublicationFlux[]
  rattachementSignalement       RattachementSignalement[]

  @@index([statutDossier], map: "idx_dossier_statut")
  @@map("dossier_traitement")
}

model DemandeComplement {
  idDemande       String              @id @default(dbgenerated("gen_random_uuid()")) @map("id_demande") @db.Uuid
  idSignalement   String              @map("id_signalement") @db.Uuid
  demandePar      String              @map("demande_par") @db.Uuid
  dateDemande     DateTime            @default(now()) @map("date_demande") @db.Timestamptz(6)
  motif           String              @db.Text
  etatDemande     String              @default("EN_ATTENTE") @map("etat_demande") @db.VarChar(20)
  reponse         ReponseComplement?
  signalement     Signalement         @relation(fields: [idSignalement], references: [idSignalement], onDelete: Restrict, onUpdate: NoAction)
  utilisateur     Utilisateur         @relation("demande_complement_demandeur", fields: [demandePar], references: [idUtilisateur], onUpdate: NoAction)

  @@index([idSignalement, dateDemande], map: "idx_demande_complement_signalement")
  @@map("demande_complement")
}

model ReponseComplement {
  idReponse       String           @id @default(dbgenerated("gen_random_uuid()")) @map("id_reponse") @db.Uuid
  idDemande       String           @unique @map("id_demande") @db.Uuid
  reponduPar      String           @map("repondu_par") @db.Uuid
  dateReponse     DateTime         @default(now()) @map("date_reponse") @db.Timestamptz(6)
  contenu         String           @db.Text
  demande         DemandeComplement @relation(fields: [idDemande], references: [idDemande], onDelete: Restrict, onUpdate: NoAction)
  utilisateur     Utilisateur      @relation("reponse_complement_auteur", fields: [reponduPar], references: [idUtilisateur], onUpdate: NoAction)

  @@map("reponse_complement")
}

model Equipe {
  idEquipe                      String                          @id @default(dbgenerated("gen_random_uuid()")) @map("id_equipe") @db.Uuid
  nomEquipe                     String                          @map("nom_equipe") @db.VarChar(150)
  description                   String?                         @db.Text
  etatEquipe                    String                          @default("ACTIVE") @map("etat_equipe") @db.VarChar(20)
  affectation                   Affectation[]
  appartenanceEquipe            AppartenanceEquipe[]
  competenceEquipe              CompetenceEquipe[]
  delegationDecisionEquipe      DelegationDecisionEquipe[]
  disponibiliteEquipe           DisponibiliteEquipe?
  evenementMetier               EvenementMetier[]
  historiqueDisponibiliteEquipe HistoriqueDisponibiliteEquipe[]

  @@map("equipe")
}

model EvenementMetier {
  idEvenement                                               String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id_evenement") @db.Uuid
  typeEvenement                                             String                   @map("type_evenement") @db.VarChar(50)
  dateEvenement                                             DateTime?                @map("date_evenement") @db.Timestamptz(6)
  dateEnregistrement                                        DateTime                 @default(now()) @map("date_enregistrement") @db.Timestamptz(6)
  origine                                                   String                   @default("PORTAIL_GESTION") @db.VarChar(30)
  idActeur                                                  String?                  @map("id_acteur") @db.Uuid
  idSignalementCible                                        String?                  @map("id_signalement_cible") @db.Uuid
  idDossierCible                                            String?                  @map("id_dossier_cible") @db.Uuid
  idRattachementCible                                       String?                  @map("id_rattachement_cible") @db.Uuid
  idAffectationCible                                        String?                  @map("id_affectation_cible") @db.Uuid
  idInterventionCible                                       String?                  @map("id_intervention_cible") @db.Uuid
  idVerificationCible                                       String?                  @map("id_verification_cible") @db.Uuid
  idUtilisateurCible                                        String?                  @map("id_utilisateur_cible") @db.Uuid
  idEquipeCible                                             String?                  @map("id_equipe_cible") @db.Uuid
  idTypeDechetCible                                         String?                  @map("id_type_dechet_cible") @db.Uuid
  idCompetenceEquipeCible                                   String?                  @map("id_competence_equipe_cible") @db.Uuid
  idDossierContenuCible                                     String?                  @map("id_dossier_contenu_cible") @db.Uuid
  idTypeDechetContenuCible                                  String?                  @map("id_type_dechet_contenu_cible") @db.Uuid
  idEvenementCorrige                                        String?                  @map("id_evenement_corrige") @db.Uuid
  donneesAvant                                              Json?                    @map("donnees_avant") @db.JsonB
  donneesApres                                              Json?                    @map("donnees_apres") @db.JsonB
  destinataireExterne                                       String?                  @map("destinataire_externe") @db.VarChar(255)
  motif                                                     String?                  @db.Text
  correlationId                                             String?                  @map("correlation_id") @db.VarChar(100)
  referenceOperationUnique                                  String?                  @unique @map("reference_operation_unique") @db.VarChar(100)
  versionSchema                                             String                   @default("2.13") @map("version_schema") @db.VarChar(10)
  contenuDossier                                            ContenuDossier?          @relation(fields: [idDossierContenuCible, idTypeDechetContenuCible], references: [idDossier, idTypeDechet], onDelete: Restrict, onUpdate: NoAction, map: "fk_evenement_contenu_dossier")
  evenementMetier                                           EvenementMetier?         @relation("evenement_metierToevenement_metier", fields: [idEvenementCorrige], references: [idEvenement], onDelete: Restrict, onUpdate: NoAction)
  otherEvenementMetier                                      EvenementMetier[]        @relation("evenement_metierToevenement_metier")
  competenceEquipe                                          CompetenceEquipe?        @relation(fields: [idCompetenceEquipeCible], references: [idCompetenceEquipe], onDelete: Restrict, onUpdate: NoAction)
  typeDechet                                                TypeDechet?              @relation(fields: [idTypeDechetCible], references: [idTypeDechet], onDelete: Restrict, onUpdate: NoAction)
  equipe                                                    Equipe?                  @relation(fields: [idEquipeCible], references: [idEquipe], onDelete: Restrict, onUpdate: NoAction)
  utilisateurEvenementMetierIdUtilisateurCibleToutilisateur Utilisateur?             @relation("evenement_metier_id_utilisateur_cibleToutilisateur", fields: [idUtilisateurCible], references: [idUtilisateur], onDelete: Restrict, onUpdate: NoAction)
  verificationResolution                                    VerificationResolution?  @relation(fields: [idVerificationCible], references: [idVerification], onDelete: Restrict, onUpdate: NoAction)
  intervention                                              Intervention?            @relation(fields: [idInterventionCible], references: [idIntervention], onDelete: Restrict, onUpdate: NoAction)
  affectation                                               Affectation?             @relation(fields: [idAffectationCible], references: [idAffectation], onDelete: Restrict, onUpdate: NoAction)
  rattachementSignalement                                   RattachementSignalement? @relation(fields: [idRattachementCible], references: [idRattachement], onDelete: Restrict, onUpdate: NoAction)
  dossierTraitement                                         DossierTraitement?       @relation(fields: [idDossierCible], references: [idDossier], onDelete: Restrict, onUpdate: NoAction)
  signalement                                               Signalement?             @relation(fields: [idSignalementCible], references: [idSignalement], onDelete: Restrict, onUpdate: NoAction)
  utilisateurEvenementMetierIdActeurToutilisateur           Utilisateur?             @relation("evenement_metier_id_acteurToutilisateur", fields: [idActeur], references: [idUtilisateur], onDelete: Restrict, onUpdate: NoAction)

  @@index([typeEvenement], map: "idx_evenement_type")
  @@index([idActeur], map: "idx_evenement_acteur")
  @@index([dateEnregistrement], map: "idx_evenement_date")
  @@map("evenement_metier")
}

model HistoriqueDisponibiliteEquipe {
  idHistorique      String      @id @default(dbgenerated("gen_random_uuid()")) @map("id_historique") @db.Uuid
  idEquipe          String      @map("id_equipe") @db.Uuid
  etatDisponibilite String      @map("etat_disponibilite") @db.VarChar(20)
  miseAJourPar      String      @map("mise_a_jour_par") @db.Uuid
  dateMiseAJour     DateTime    @default(now()) @map("date_mise_a_jour") @db.Timestamptz(6)
  valideJusqua      DateTime    @map("valide_jusqua") @db.Timestamptz(6)
  commentaire       String?     @db.Text
  utilisateur       Utilisateur @relation(fields: [miseAJourPar], references: [idUtilisateur], onUpdate: NoAction)
  equipe            Equipe      @relation(fields: [idEquipe], references: [idEquipe], onUpdate: NoAction)

  @@map("historique_disponibilite_equipe")
}

model HistoriqueLocalisationDossier {
  idHistorique            String            @id @default(dbgenerated("gen_random_uuid()")) @map("id_historique") @db.Uuid
  idDossier               String            @map("id_dossier") @db.Uuid
  idCommune               String?           @map("id_commune") @db.Uuid
  latitude                Decimal?          @db.Decimal(10, 7)
  longitude               Decimal?          @db.Decimal(10, 7)
  precisionLocalisation   Decimal?          @map("precision_localisation") @db.Decimal(8, 2)
  descriptionLocalisation String?           @map("description_localisation") @db.Text
  modifiePar              String            @map("modifie_par") @db.Uuid
  dateModification        DateTime          @default(now()) @map("date_modification") @db.Timestamptz(6)
  motif                   String?           @db.Text
  utilisateur             Utilisateur       @relation(fields: [modifiePar], references: [idUtilisateur], onUpdate: NoAction)
  commune                 Commune?          @relation(fields: [idCommune], references: [idCommune], onDelete: Restrict, onUpdate: NoAction)
  dossierTraitement       DossierTraitement @relation(fields: [idDossier], references: [idDossier], onUpdate: NoAction)

  @@map("historique_localisation_dossier")
}

model HistoriquePoints {
  idPoint               String             @id @default(dbgenerated("gen_random_uuid()")) @map("id_point") @db.Uuid
  idUtilisateur         String             @map("id_utilisateur") @db.Uuid
  idSignalement         String?            @map("id_signalement") @db.Uuid
  points                Int                @db.Integer
  dateAttribution       DateTime           @default(now()) @map("date_attribution") @db.Timestamptz(6)
  motif                 String             @db.VarChar(255)
  typeMouvement         String             @map("type_mouvement") @db.VarChar(20)
  idPointOrigine        String?            @map("id_point_origine") @db.Uuid
