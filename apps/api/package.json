{
  "name": "@isieco/api",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API REST Fastify + TypeScript pour ISI-Eco Report",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "npm run prisma:generate",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run prisma:generate",
    "pretypecheck": "npm run prisma:generate",
    "pretest": "npm run prisma:generate",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "migrate:pg": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "retention:photos": "tsx src/scripts/purge-expired-photos.ts",
    "retention:photos:worker": "node dist/scripts/run-photo-retention-worker.js",
    "seed:pg": "tsx src/db/seeds/seed_systeme_dakar.ts",
    "seed:demo": "tsx src/db/seeds/seed_demo_data.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.2",
    "@isieco/shared": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "pg": "^8.13.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "prisma": "^7.10.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
