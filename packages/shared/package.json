{
  "name": "@isieco/shared",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared Zod schemas, DTOs, and domain enums for ISI-Eco Report",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
