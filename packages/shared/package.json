    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Shared package typechecked successfully\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
